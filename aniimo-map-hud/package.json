{
  "name": "aniimo-egg-map-hud",
  "version": "0.19.0",
  "private": true,
  "description": "Windows overlay for Aniimo egg-heist maps",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.ubereats6.aniimoeggmaphud",
    "productName": "Aniimo Egg Map HUD",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "renderer.js",
      "matcher.html",
      "matcher-ui.js",
      "matcher-worker.js",
      "features.json",
      "icon.webp",
      "icon.ico",
      "maps.json",
      "marker-layers.json",
      "database.js",
      "database-version.json",
      "door-finder.js",
      "portal-ui.js",
      "portal-ui.css",
      "maps/easy/53.webp",
      "clean-maps/easy/53.webp",
      "maps/easy/54.webp",
      "clean-maps/easy/54.webp",
      "maps/easy/55.webp",
      "clean-maps/easy/55.webp",
      "maps/easy/56.webp",
      "clean-maps/easy/56.webp",
      "maps/easy/57.webp",
      "clean-maps/easy/57.webp",
      "maps/easy/58.webp",
      "clean-maps/easy/58.webp",
      "maps/easy/59.webp",
      "clean-maps/easy/59.webp",
      "maps/easy/60.webp",
      "clean-maps/easy/60.webp",
      "maps/hard/41.webp",
      "clean-maps/hard/41.webp",
      "maps/hard/42.webp",
      "clean-maps/hard/42.webp",
      "maps/hard/45.webp",
      "clean-maps/hard/45.webp",
      "maps/hard/48.webp",
      "clean-maps/hard/48.webp",
      "maps/hard/49.webp",
      "clean-maps/hard/49.webp",
      "maps/hard/50.webp",
      "clean-maps/hard/50.webp",
      "maps/nightmare/32.webp",
      "clean-maps/nightmare/32.webp",
      "maps/nightmare/34.webp",
      "clean-maps/nightmare/34.webp",
      "maps/nightmare/35.webp",
      "clean-maps/nightmare/35.webp",
      "maps/nightmare/36.webp",
      "clean-maps/nightmare/36.webp",
      "maps/nightmare/37.webp",
      "clean-maps/nightmare/37.webp",
      "maps/nightmare/39.webp",
      "clean-maps/nightmare/39.webp",
      "maps/nightmare/40.webp",
      "clean-maps/nightmare/40.webp",
      "marker-icons/chest-ab5186075943.webp",
      "marker-icons/egg-685295943851.webp",
      "marker-icons/side-1749d9c68c7a.webp",
      "marker-icons/main-2d4462552f65.webp",
      "marker-icons/challenge-1b6bc7fc3809.webp",
      "marker-icons/key-d56331c22188.webp",
      "marker-icons/key-a39191ef8700.webp",
      "marker-icons/key-1e8acf2f9748.webp"
    ],
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Aniimo Egg Map HUD",
        "schemes": [
          "aniimo-egg-map"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "AniimoEggMapHUD-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "AniimoEggMapHUD-Portable-v${version}.exe"
    }
  }
}
